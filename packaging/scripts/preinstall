#!/bin/bash
set -euo pipefail
[[ ${3:-/} == / ]] || { echo 'Install on the running system only.' >&2; exit 1; }
[[ $(uname -m) == x86_64 && $(/usr/sbin/sysctl -n hw.optional.arm64 2>/dev/null || true) != 1 ]] || { echo 'This package is Intel-only.' >&2; exit 1; }
# Back up an existing HAL bundle before pkg payload replacement.
old='/Library/Audio/Plug-Ins/HAL/Audio2DJ.driver'
if [[ -e "$old" ]]; then
 backup="/Library/Application Support/Audio2DJExperimental-Backups/$(date +%Y%m%d-%H%M%S)-$$"
 mkdir -p "$backup"
 /usr/bin/ditto "$old" "$backup/Audio2DJ.driver"
fi
uid=$(stat -f %u /dev/console)
if [[ "$uid" -ge 500 ]]; then /bin/launchctl bootout "gui/$uid/org.local.audio2dj.bridge" 2>/dev/null || true; fi
